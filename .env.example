# Copy this file to ".env" and change the values.
# Note: keep comments on their own line (Docker does not allow comments after a value).

# ---- Your site ----
SITE_NAME=MySiteName
SITE_URL=https://example.com
CONTACT_EMAIL=contact@example.com

# ---- Server ----
PORT=3000
# Trust the visitor IP sent by Nginx on the same machine / Docker network.
TRUST_PROXY=loopback, uniquelocal

# ---- Limits (all can be changed) ----
# Downloads per visitor per hour
JOBS_PER_HOUR=10
# "Get options" clicks per visitor per hour
INFO_PER_HOUR=60
# Longest video allowed
MAX_DURATION_MINUTES=60
# Biggest file allowed
MAX_FILE_SIZE_MB=500
# Jobs running at the same time (1 per CPU core is safe)
MAX_CONCURRENT_JOBS=2
# Jobs allowed to wait in line
MAX_QUEUED_JOBS=50
# Stuck jobs are stopped after this
JOB_TIMEOUT_MINUTES=15
# Finished files are deleted after this
FILE_TTL_MINUTES=30

# ---- Tools (normally leave as is) ----
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# YTDLP_JS_RUNTIME=node
